# infra-automation-core/config/.env.example
#
# Copy to .env and fill in values for local development.
# NEVER commit a populated .env file.
# In CI, all these are GitHub Actions Secrets → injected as env vars.

# ---------------------------------------------------------------------------
# Azure authentication (ARM provider for Terraform)
# ---------------------------------------------------------------------------
ARM_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
ARM_TENANT_ID=00000000-0000-0000-0000-000000000000
ARM_CLIENT_ID=00000000-0000-0000-0000-000000000000
ARM_CLIENT_SECRET=                   # Only for local dev; use OIDC in CI

# ---------------------------------------------------------------------------
# Cosmos DB inventory
# ---------------------------------------------------------------------------
COSMOS_ENDPOINT=https://cosmos-iaac-dev.documents.azure.com:443/
COSMOS_DATABASE=iaac-platform

# ---------------------------------------------------------------------------
# Azure Blob Storage (log archive)
# ---------------------------------------------------------------------------
AZURE_LOG_STORAGE_ACCOUNT=stiaacdevlogs
AZURE_LOG_CONTAINER=logs

# ---------------------------------------------------------------------------
# Email notifications
# ---------------------------------------------------------------------------
EMAIL_BACKEND=sendgrid           # sendgrid | smtp
SENDGRID_API_KEY=SG.xxxxxxxxxxxx
EMAIL_SENDER=noreply@iaac-platform.io

# SMTP fallback (used when EMAIL_BACKEND=smtp)
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USERNAME=notifications@yourorg.com
# SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# Terraform
# ---------------------------------------------------------------------------
TF_MODULES_ROOT=/path/to/infra-terraform-modules

# ---------------------------------------------------------------------------
# Platform (API layer)
# ---------------------------------------------------------------------------
PIPELINE_BACKEND=github          # github | azuredevops
GITHUB_TOKEN=ghp_xxxxxxxxxxxx
GITHUB_REPO_OWNER=your-org
GITHUB_REPO_NAME=infra-automation-core
GITHUB_WORKFLOW_ID=provision.yml
GITHUB_WORKFLOW_REF=main

# Azure DevOps alternative (set PIPELINE_BACKEND=azuredevops)
# AZDO_ORG_URL=https://dev.azure.com/your-org
# AZDO_PROJECT=InfraPlatform
# AZDO_PIPELINE_ID=42
# AZDO_PAT_TOKEN=

# API service
APP_ENV=dev
PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
